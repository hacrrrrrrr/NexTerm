{
  "version": 2,
  "name": "nexterm-session",
  "encoding": "utf-8",
  "messages": {
    "hello": {"token": "string", "client": "string", "version": "string", "session": "string"},
    "pair": {"session": "string", "token": "string", "expires": "integer"},
    "input": {"data": "utf8"},
    "output": {"data": "utf8"},
    "resize": {"rows": "integer", "cols": "integer"},
    "signal": {"name": "string"},
    "close": {},
    "ping": {},
    "pong": {},
    "error": {"code": "string", "message": "string"}
  },
  "rules": {
    "rows_min": 2,
    "rows_max": 500,
    "cols_min": 8,
    "cols_max": 500,
    "max_input_bytes": 65536,
    "max_output_bytes": 1048576,
    "max_control_message_bytes": 16384,
    "token_min_bytes": 32,
    "pairing_max_lifetime_ms": 600000,
    "require_expiry_validation": true,
    "single_use_pairing_recommended": true
  },
  "security": {
    "transport": "wss_required_in_production",
    "tokens": "short_lived_bearer",
    "server_must_validate": ["session", "token", "expires"],
    "never_persist_long_lived_credentials": true
  },
  "compatibility": {"previous": [1], "unknown_messages": "ignore"}
}
